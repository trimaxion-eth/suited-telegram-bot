# Copy to .env and fill in. `.env` is gitignored — never commit it.
TELEGRAM_BOT_TOKEN=123456789:replace-with-the-botfather-token

SUITED_BASE=https://suited.club
POLL_SECONDS=30
DIGEST_HOUR=9
STATE_PATH=data/bot.sqlite

# Read-only spectator session (seat names and live hands in /now).
# Off unless set to 1. Generate the key once:
#   python3 spectator.py --keygen
SPECTATOR=0
SPECTATOR_KEY_FILE=data/spectator.key
SPECTATOR_CACHE=data/spectator.json

# Optional: channel id, once the channel leg is wired up (run /id there).
CHANNEL_ID=
